# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_TOKEN

# LLM (Groq API — free tier at console.groq.com)
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_KEY
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Optional: lighter model for tool-calling rounds (defaults to GROQ_MODEL)
# GROQ_TOOL_MODEL=llama-3.1-8b-instant
# Optional: hybrid mode = cheap provider runs the tool loop, Groq polishes the
# final answer once (needs OLLAMA_BASE_URL or OPENROUTER_API_KEY). Default false.
# LLM_HYBRID_MODE=true
# LLM_HYBRID_TOOL_PROVIDER=openrouter  # or 'ollama'
GROQ_POLISH_MODEL=llama-3.1-8b-instant

# OpenRouter (optional, for hybrid tool loop or direct use)
# Get key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemma-2-9b-it
# OPENROUTER_MAX_TOKENS=300

# Local LLM (optional, only if LLM_PROVIDER=ollama or LLM_HYBRID_TOOL_PROVIDER=ollama)
LLM_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL=llama3.2-vision:latest

# Financial Data
FINNHUB_API_KEY=YOUR_FINNHUB_KEY

# SEC EDGAR (no key needed, but SEC requires a real identifying User-Agent)
SEC_USER_AGENT=Atlas Financial Assistant your-email@example.com

# Google OAuth (Gmail + Calendar) — create a "Web application" OAuth client
# in Google Cloud Console and add GOOGLE_OAUTH_REDIRECT_URI to its
# Authorized redirect URIs. Optional — bot runs fine without these, Gmail/
# Calendar tools just stay unavailable until set.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth2callback
GOOGLE_OAUTH_PORT=8765

# Scheduler
ALERT_CHECK_MINUTES=3

# Database
DATABASE_URL=sqlite:///./assistant.db